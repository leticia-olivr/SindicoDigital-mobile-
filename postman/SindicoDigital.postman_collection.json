{
  "info": {
    "name": "SindicoDigital API",
    "description": "Coleção da API SíndicoDigital. Importa no Postman ou no Insomnia.\n\n1. Suba a API (npm run dev). baseUrl padrão: http://localhost:3000.\n2. Rode npm run db:migrate e npm run db:seed.\n3. Faça um login. O token fica na variável token.\n4. Login de SINDICO grava sindicoId. Login de MORADOR grava moradorUsuarioId.\n5. Listar apartamentos grava unidadeId e condominioId.\n6. Criar categoria, ocorrência e comunicado grava os ids usados nos requests seguintes.\n\nSenha dos usuários de demonstração: Demo@123.\nadmin@sindicodigital.test, sindica@sindicodigital.test, morador1@sindicodigital.test, morador2@sindicodigital.test.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "senhaDemo",
      "value": "Demo@123"
    },
    {
      "key": "emailAdmin",
      "value": "admin@sindicodigital.test"
    },
    {
      "key": "emailSindico",
      "value": "sindica@sindicodigital.test"
    },
    {
      "key": "emailMorador",
      "value": "morador1@sindicodigital.test"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "meuId",
      "value": ""
    },
    {
      "key": "usuarioId",
      "value": ""
    },
    {
      "key": "moradorUsuarioId",
      "value": ""
    },
    {
      "key": "sindicoId",
      "value": ""
    },
    {
      "key": "unidadeId",
      "value": ""
    },
    {
      "key": "condominioId",
      "value": ""
    },
    {
      "key": "moradorId",
      "value": ""
    },
    {
      "key": "apartamentoId",
      "value": ""
    },
    {
      "key": "categoriaId",
      "value": ""
    },
    {
      "key": "ocorrenciaId",
      "value": ""
    },
    {
      "key": "comunicadoId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Health",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Autenticação",
      "item": [
        {
          "name": "Signup (cadastro de morador)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "signup"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Novo Morador\",\n  \"email\": \"morador{{$timestamp}}@sindicodigital.test\",\n  \"senha\": \"{{senhaDemo}}\"\n}"
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Cria um usuário MORADOR. O e-mail usa {{$timestamp}} para não repetir."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Tipo padrão MORADOR', () => pm.expect(pm.response.json().tipo).to.eql('MORADOR'));",
                  "pm.test('Resposta sem senha', () => pm.expect(pm.response.json()).to.not.have.property('senha_hash'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login como MORADOR",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailMorador}}\",\n  \"senha\": \"{{senhaDemo}}\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const dados = pm.response.json();",
                  "pm.collectionVariables.set('token', dados.token);",
                  "pm.collectionVariables.set('meuId', String(dados.usuario.id));",
                  "if (dados.usuario.tipo === 'SINDICO') pm.collectionVariables.set('sindicoId', String(dados.usuario.id));",
                  "if (dados.usuario.tipo === 'MORADOR') pm.collectionVariables.set('moradorUsuarioId', String(dados.usuario.id));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login como SINDICO",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailSindico}}\",\n  \"senha\": \"{{senhaDemo}}\"\n}"
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Grava sindicoId. Faça este login antes de associar condomínio, e depois entre de novo como ADMIN."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const dados = pm.response.json();",
                  "pm.collectionVariables.set('token', dados.token);",
                  "pm.collectionVariables.set('meuId', String(dados.usuario.id));",
                  "if (dados.usuario.tipo === 'SINDICO') pm.collectionVariables.set('sindicoId', String(dados.usuario.id));",
                  "if (dados.usuario.tipo === 'MORADOR') pm.collectionVariables.set('moradorUsuarioId', String(dados.usuario.id));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login como ADMIN",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailAdmin}}\",\n  \"senha\": \"{{senhaDemo}}\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const dados = pm.response.json();",
                  "pm.collectionVariables.set('token', dados.token);",
                  "pm.collectionVariables.set('meuId', String(dados.usuario.id));",
                  "if (dados.usuario.tipo === 'SINDICO') pm.collectionVariables.set('sindicoId', String(dados.usuario.id));",
                  "if (dados.usuario.tipo === 'MORADOR') pm.collectionVariables.set('moradorUsuarioId', String(dados.usuario.id));"
                ]
              }
            }
          ]
        },
        {
          "name": "Me (usuário logado)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login com senha inválida",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailAdmin}}\",\n  \"senha\": \"senha-errada\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",

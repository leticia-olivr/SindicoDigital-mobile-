{
  "info": {
    "name": "SindicoDigital API",
    "description": "Coleção de testes da API SíndicoDigital.\n\nComo usar:\n1. Ajuste a variável baseUrl na aba Variables da coleção (local: http://localhost:3000; produção: URL da Vercel).\n2. Execute um dos requests de login. O token é salvo automaticamente na variável token.\n3. Os demais requests usam o token salvo pelo último login.\n\nUsuários de demonstração (senha Demo@123): admin@sindicodigital.test, sindica@sindicodigital.test, morador1@sindicodigital.test e morador2@sindicodigital.test.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "senhaDemo",
      "value": "Demo@123"
    },
    {
      "key": "emailAdmin",
      "value": "admin@sindicodigital.test"
    },
    {
      "key": "emailSindico",
      "value": "sindica@sindicodigital.test"
    },
    {
      "key": "emailMorador",
      "value": "morador1@sindicodigital.test"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "meuId",
      "value": ""
    },
    {
      "key": "usuarioId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Autenticação",
      "item": [
        {
          "name": "Signup (cadastro de morador)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "signup"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Novo Morador\",\n  \"email\": \"morador{{$timestamp}}@sindicodigital.test\",\n  \"senha\": \"{{senhaDemo}}\"\n}"
            },
            "description": "Cria um usuário do tipo MORADOR. O e-mail usa {{$timestamp}} para ser único a cada execução."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Tipo padrão MORADOR', () => pm.expect(pm.response.json().tipo).to.eql('MORADOR'));",
                  "pm.test('Resposta sem senha', () => pm.expect(pm.response.json()).to.not.have.property('senha_hash'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login como MORADOR",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailMorador}}\",\n  \"senha\": \"{{senhaDemo}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const dados = pm.response.json();",
                  "pm.collectionVariables.set('token', dados.token);",
                  "pm.collectionVariables.set('meuId', dados.usuario.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login como SINDICO",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailSindico}}\",\n  \"senha\": \"{{senhaDemo}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const dados = pm.response.json();",
                  "pm.collectionVariables.set('token', dados.token);",
                  "pm.collectionVariables.set('meuId', dados.usuario.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login como ADMIN",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailAdmin}}\",\n  \"senha\": \"{{senhaDemo}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const dados = pm.response.json();",
                  "pm.collectionVariables.set('token', dados.token);",
                  "pm.collectionVariables.set('meuId', dados.usuario.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Me (usuário logado)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Usuários",
      "description": "Faça login como ADMIN ou SINDICO antes de executar esta pasta. Com o login de MORADOR, as rotas de gestão retornam 403.",
      "item": [
        {
          "name": "Listar usuários",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/usuarios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Criar usuário",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/usuarios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Usuário Criado\",\n  \"email\": \"criado{{$timestamp}}@sindicodigital.test\",\n  \"senha\": \"{{senhaDemo}}\",\n  \"tipo\": \"MORADOR\"\n}"
            },
            "description": "O id do usuário criado é salvo na variável usuarioId, usada nos próximos requests."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('usuarioId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Buscar usuário por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/usuarios/{{usuarioId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios",
                "{{usuarioId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Atualizar usuário",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/usuarios/{{usuarioId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios",
                "{{usuarioId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Usuário Atualizado\"\n}"
            },
            "description": "Envie apenas os campos que serão alterados: nome, email, senha ou tipo. Somente ADMIN altera o tipo."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Nome atualizado', () => pm.expect(pm.response.json().nome).to.eql('Usuário Atualizado'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Excluir usuário",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/usuarios/{{usuarioId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios",
                "{{usuarioId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Encerrar sessão",
      "item": [
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            },
            "description": "Revoga o token atual. Depois do logout, o mesmo token passa a receber 401."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
